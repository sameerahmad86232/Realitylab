# Server-only. Set the real value securely; never commit it.
# BASETEN_API_KEY=your-key
# Optional Meta image generation for explicit per-component concept illustrations.
# META_API_KEY=your-meta-model-api-key
# META_IMAGE_MODEL=the-current-supported-muse-image-model-id
# META_API_BASE_URL=https://api.meta.ai/v1
# Optional canonical origin, normally discovered from Render's RENDER_EXTERNAL_URL.
# APP_ORIGIN=https://realitylab.onrender.com
# Optional shared hourly request quota using an Upstash Redis REST database.
# Set both values together. Keep the token server-only.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# INFERENCE_REQUESTS_PER_HOUR=50
# Set true only after the shared store is configured and tested; requests fail closed if it is unavailable.
# DURABLE_QUOTA_REQUIRED=false
# Set true only after manually confirming a provider-side billing/spend cap.
# PROVIDER_SPEND_CAP_VERIFIED=false

# P0: Production live inference is private and fails closed until these are set.
# REALITYLAB_ACCESS_CODE=strong-random-16-or-more-characters
# REALITYLAB_SESSION_SECRET=different-random-32-or-more-characters
# Production requires Upstash Redis and the provider cap attestation; see docs/P0_SECURITY.md.
