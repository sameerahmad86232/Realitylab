{
  "name": "realitylab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/design.mjs",
    "test:capture": "node tests/capture.mjs",
    "test:api": "node --experimental-strip-types --test tests/scan-api.test.ts",
    "test:live-ui": "node tests/live-ui.mjs",
    "test:exploration": "node tests/exploration.mjs",
    "test:unit": "node --experimental-strip-types --test tests/exploration.test.ts tests/blueprint.test.ts tests/svg-text.test.ts tests/observations.test.ts tests/evaluation.test.ts tests/stability-trial.test.ts tests/observation-followup.test.ts tests/project-file.test.ts tests/limits.test.ts",
    "test:blueprint": "node tests/blueprint.mjs",
    "test:server-envelope": "node tests/server-envelope.mjs",
    "test:learning": "node --experimental-strip-types --test tests/learning.test.ts",
    "test:learn-ui": "node tests/learning.mjs",
    "test": "npm run test:api && npm run test:unit && npm run test:learning && npm run test:security",
    "test:demos": "node tests/demos.mjs",
    "test:audit": "node tests/audit.mjs",
    "test:resilience": "node tests/resilience.mjs",
    "test:theater": "node tests/theater.mjs",
    "test:project": "node tests/project.mjs",
    "eval:recorded": "node --use-env-proxy --use-system-ca scripts/evaluate.mjs --mode archived",
    "eval:plan": "node --use-env-proxy --use-system-ca scripts/evaluate.mjs --mode plan",
    "eval:live": "node --use-env-proxy --use-system-ca scripts/evaluate.mjs --mode live",
    "eval:review": "node scripts/evaluate.mjs --mode review",
    "test:trial": "node tests/stability-trial.mjs",
    "test:recovery": "node tests/project-recovery.mjs",
    "test:security": "node --experimental-strip-types --test tests/access.test.ts",
    "test:prod-security": "node tests/production-security.mjs",
    "test:devices": "node tests/device-accessibility.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
