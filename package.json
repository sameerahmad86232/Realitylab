{
  "name": "realitylab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env server/src/index.js",
    "build": "npm --prefix frontend run build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "smoke": "node scripts/smoke.mjs",
    "validate:photos": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env scripts/validate-photos.mjs",
    "test:shader": "node tests/shader-browser.mjs",
    "test:camera-cad": "node tests/camera-cad-browser.mjs",
    "test:scan": "node tests/scan-browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
